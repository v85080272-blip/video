   "sfx": [
    "sting"
   ]
  },
  {
   "id": "L34",
   "who": "S",
   "fx": "radio",
   "text": "Что у тебя?",
   "shot": 24,
   "gap": 0.3
  },
  {
   "id": "B11",
   "beat": 3.0,
   "shot": null,
   "gap": 0.0
  },
  {
   "id": "L35",
   "who": "H",
   "fx": "whisper",
   "text": "Соколов… где ты?",
   "shot": null,
   "gap": 0.2
  },
  {
   "id": "B12",
   "beat": 1.4,
   "shot": null,
   "gap": 0.0
  },
  {
   "id": "L36",
   "copy": "L26",
   "fx": "radio",
   "shot": null,
   "gap": 0.0,
   "drone": 0
  },
  {
   "id": "L37",
   "who": "N",
   "fx": "vo",
   "text": "Тот же щелчок перед первым словом. Тот же голос. Тот же кусок записи.",
   "shot": 47,
   "gap": 1.6
  },
  {
   "id": "L38",
   "who": "N",
   "fx": "vo",
   "text": "Я открыл на терминале схему комплекса.",
   "shot": 25,
   "gap": 1.0,
   "scene": "twist",
   "overlay": "plan"
  },
  {
   "id": "L39",
   "who": "N",
   "fx": "vo",
   "text": "Шлюз, который мне велели открыть, вёл не наружу. Он соединял изолятор с остальным зданием.",
   "shot": null,
   "gap": 0.4
  },
  {
   "id": "L40",
   "who": "N",
   "fx": "vo",
   "text": "Всё это время я шёл к ним.",
   "shot": 1,
   "gap": 0.9
  },
  {
   "id": "L41",
   "who": "N",
   "fx": "vo",
   "text": "На соседнем мониторе была запись аварии. Настоящий Соколов говорил по громкой связи.",
   "shot": 26,
   "gap": 1.0
  },
  {
   "id": "L42",
   "who": "S",
   "fx": "pa",
   "parts": [
    "S_A",
    "S_B"
   ],
   "text": "Старший смены охраны. Соколов. Я тебя проведу.",
   "shot": null,
   "gap": 0.5
  },
  {
   "id": "L43",
   "who": "N",
   "fx": "vo",
   "text": "Я уже слышал эти слова. Слово в слово.",
   "shot": 8,
   "gap": 0.9
  },
  {
   "id": "L44",
   "who": "N",
   "fx": "vo",
   "text": "Я открыл камеру изолятора.",
   "shot": 27,
   "gap": 0.8,
   "overlay": "cctv"
  },
  {
   "id": "L45",
   "who": "N",
   "fx": "vo",
   "text": "У переговорного устройства стоял человек. Не двигался. Слушал.",
   "shot": null,
   "gap": 0.5
  },
  {
   "id": "L46",
   "who": "H",
   "fx": "whisper",
   "text": "Кто ты?",
   "shot": null,
   "gap": 1.0
  },
  {
   "id": "B13",
   "beat": 1.2,
   "shot": 28,
   "gap": 0.0
  },
  {
   "id": "L47",
   "copy": "L46",
   "fx": "radio",
   "shot": null,
   "gap": 0.0
  },
  {
   "id": "B14",
   "beat": 1.6,
   "shot": null,
   "gap": 0.0
  },
  {
   "id": "L48",
   "who": "N",
   "fx": "vo",
   "text": "Они помнят всё, что умели раньше. Умеют ждать. И повторяют всё, что слышат.",
   "shot": 29,
   "gap": 0.4
  },
  {
   "id": "L49",
   "who": "N",
   "fx": "vo",
   "text": "Чем дольше с ними говоришь, тем лучше у них получается.",
   "shot": null,
   "gap": 0.6
  },
  {
   "id": "L50",
   "who": "N",
   "fx": "vo",
   "text": "Соколов был настоящим. Но всю ночь со мной говорил кто-то другой.",
   "shot": 7,
   "gap": 0.9
  },
  {
   "id": "B15",
   "beat": 1.8,
   "shot": 30,
   "gap": 0.8,
   "overlay": "timer",
   "sfx": [
    "alarm"
   ],
   "scene": "count",
   "pulse": 1
  },
  {
   "id": "L51",
   "who": "N",
   "fx": "vo",
   "text": "Отменить с пульта не вышло. Ручная блокировка была в техническом проходе, у самого шлюза.",
   "shot": null,
   "gap": 0.2
  },
  {
   "id": "L52",
   "who": "N",
   "fx": "vo",
   "text": "Я побежал.",
   "shot": 31,
   "gap": 0.3,
   "sfx": [
    "run"
   ]
  },
  {
   "id": "L53",
   "who": "S",
   "fx": "pa",
   "text": "Не трогай ничего.",
   "shot": 32,
   "gap": 0.4
  },
  {
   "id": "L54",
   "who": "P",
   "fx": "pa",
   "text": "Здесь остались люди.",
   "shot": null,
   "gap": 0.3,
   "tts": "Здесь оста́лись люди."
  },
  {
   "id": "L55",
   "who": "W",
   "fx": "pa",
   "text": "Ты нас запрёшь!",
   "shot": 31,
   "gap": 0.3
  },
  {
   "id": "L56",
   "who": "N",
   "fx": "vo",
   "text": "У рычага я замер. Из-за двери шлюза звучал голос.",
   "shot": 34,
   "gap": 0.6
  },
  {
   "id": "L57",
   "copy": "L03",
   "fx": "door",
   "shot": 33,
   "gap": 0.6
  },
  {
   "id": "L58",
   "who": "N",
   "fx": "vo",
   "text": "Мой голос. Мои слова. Пока я искал выход, они слушали и меня.",
   "shot": null,
   "gap": 0.8
  },
  {
   "id": "L59",
   "who": "N",
   "fx": "vo",
   "text": "Я рванул рычаг вниз.",
   "shot": 34,
   "gap": 0.4,
   "sfx": [
    "lever"
   ]
  },
  {
   "id": "B16",
   "beat": 1.0,
   "shot": 35,
   "gap": 0.0,
   "sfx": [
    "door_stop"
   ]
  },
  {
   "id": "L60",
   "who": "N",
   "fx": "vo",
   "text": "Дверь успела приоткрыться на пару сантиметров. В щели показались пальцы.",
   "shot": null,
   "gap": 0.2
  },
  {
   "id": "L61",
   "who": "N",
   "fx": "vo",
   "text": "Я довёл блокировку до конца.",
