   "gap": 1.0
  },
  {
   "id": "L33",
   "who": "N",
   "fx": "vo",
   "text": "На бейдже я прочитал фамилию.",
   "shot": 23,
   "gap": 0.6,
   "overlay": "badge"
  },
  {
   "id": "B10",
   "beat": 2.2,
