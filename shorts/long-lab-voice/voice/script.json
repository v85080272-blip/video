   "gap": 0.2
  },
  {
   "id": "L23",
   "copy": "L22",
   "fx": "near",
   "shot": null,
   "gap": 1.3
  },
  {
   "id": "L24",
   "who": "N",
   "fx": "vo",
   "text": "Так говорил охранник на проходной. Каждое утро. Каждому из нас.",
   "shot": 16,
   "gap": 0.8
  },
  {
   "id": "L25",
   "who": "N",
   "fx": "vo",
   "text": "Он прошёл в двух шагах от меня и скрылся в темноте.",
   "shot": null,
   "gap": 0.5
  },
  {
   "id": "B08",
   "beat": 1.8,
   "shot": 50,
   "gap": 0.0,
   "sfx": [
    "shuffle_far"
   ]
  },
  {
   "id": "L26",
   "who": "S",
   "fx": "radio",
   "text": "Ты всё делаешь правильно.",
   "shot": 17,
   "gap": 0.4,
   "sfx": [
    "torch_on"
   ],
   "dark": 0
  },
  {
   "id": "L27",
   "who": "N",
   "fx": "vo",
   "text": "Этот голос только что меня спас. Теперь я верил ему ещё больше.",
   "shot": null,
   "gap": 0.7
  },
  {
   "id": "L28",
   "who": "N",
   "fx": "vo",
   "text": "Впереди светился пост охраны. Внутри работал телевизор.",
   "shot": 18,
   "gap": 0.7,
   "sfx": [
    "tv"
   ]
  },
  {
   "id": "L29",
   "who": "N",
   "fx": "vo",
   "text": "За столом никого не было. Опрокинутый стул. Недопитый чай.",
   "shot": 19,
   "gap": 0.9,
   "scene": "post"
  },
  {
   "id": "L30",
   "who": "S",
   "fx": "radio",
   "text": "На панели зелёная кнопка. Нажми. Восстановление займёт несколько минут.",
   "shot": 20,
   "gap": 0.7
  },
  {
   "id": "B09",
   "beat": 1.2,
   "shot": null,
   "gap": 0.0,
   "sfx": [
    "button"
   ]
  },
  {
   "id": "L31",
   "who": "N",
   "fx": "vo",
   "text": "На экране пошла загрузка. Шлюз готовился к открытию.",
   "shot": 21,
   "gap": 0.2,
   "overlay": "progress"
  },
  {
   "id": "L32",
   "who": "N",
   "fx": "vo",
   "text": "И тут под столом я увидел куртку охранника. Пустую. Рядом лежала рация.",
